# AI provider
# Anthropic direct is the default path for course generation.
ANTHROPIC_API_KEY=

# Optional: Vercel AI Gateway fallback when ANTHROPIC_API_KEY is empty.
AI_GATEWAY_API_KEY=

# Optional: override the generation model.
# Default for course generation: claude-haiku-4-5-20251001
# COURSE_MODEL=claude-haiku-4-5-20251001

# Optional: how many LangGraph module-writer calls run in parallel.
# Default: 3
# COURSE_MODULE_CONCURRENCY=3

# Optional: production-style Python FastAPI/LangGraph backend for course generation.
# Leave empty to use the in-process Next.js LangGraph fallback.
# PYTHON_BACKEND_URL=http://127.0.0.1:8000

# YouTube Data API v3 for embedded "best match" videos.
# Create a key in Google Cloud Console and enable "YouTube Data API v3".
YOUTUBE_API_KEY=

# Optional SerpAPI fallback for YouTube video search:
# https://serpapi.com/search?engine=youtube
SERPAPI_API_KEY=

# ── Autopilot: real application submission ──────────────────────────────────
#
# Empty or unset means every ATS stays at prepare-only: Autopilot reads the
# posting, tailors the résumé, answers what it can and hands the last step to
# the candidate. That is the default and it is the safe one.
#
# Naming a vendor here turns on *automatic submission* for that vendor, which
# also unlocks walking a multi-page application to its end. Set it only for a
# path you have reviewed yourself — the employer's and the ATS vendor's terms
# on automated access differ, and this flag is the record of that decision.
#
# It can promote an UNREVIEWED path. It can never override an explicit block,
# so "all" still does not enable Workday.
#
#   AUTOPILOT_SUBMIT_ENABLED=greenhouse,lever
#   AUTOPILOT_SUBMIT_ENABLED=all
#
AUTOPILOT_SUBMIT_ENABLED=

# Optional: raises GitHub's API rate limit for portfolio rebuilds.
#
# The portfolio reads only PUBLIC repositories -- the privacy gate refuses to
# publish a private one under any circumstances, so no user OAuth is needed and
# none is requested. Unauthenticated, GitHub allows 60 requests an hour PER IP,
# shared by every user of the deployment; one rebuild costs up to 25. A token
# raises that to 5,000/hour. Use a fine-grained token with NO repository access
# -- public read is all this needs.
GITHUB_TOKEN=

# ── Autopilot development ───────────────────────────────────────────────────
#
# Watch the browser work. Opens a real window and slows each action down, which
# finds an adapter bug faster than any log line: you see the cursor land in the
# wrong box. Never set this on a server -- a machine with no display cannot
# open a window.
# AUTOPILOT_HEADED=1
# AUTOPILOT_SLOWMO=250
#
# Keep a screenshot, a DOM snapshot and the decision trail per application.
# This is what makes supporting more ATS platforms tractable: "the form is not
# complete" explains nothing, and the page it happened on explains everything.
#
# Off by default on purpose. These files contain a candidate's name, address
# and answers on a real employer's page -- that is personal data, and capturing
# it should be a decision rather than a default that quietly fills a disk.
# AUTOPILOT_ARTIFACTS=./artifacts
